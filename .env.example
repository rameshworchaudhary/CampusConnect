# ==============================================================
# CampusConnect — Environment Configuration Template
# ==============================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campusconnect
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusconnect
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Signing Secret (minimum 32 characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Frontend & Backend Base URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# SMTP Email Configuration (Google App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password
MAIL_FROM=your_gmail_address@gmail.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap Super Admin Credentials (used during first startup if no super admin exists)
ADMIN_EMAIL=admin@univ.edu
ADMIN_PASSWORD=replace_with_a_bootstrap_password
ADMIN_NAME=SuperAdmin

# Optional Demo Data Seeding (true / false)
SEED_DEMO_DATA=false
